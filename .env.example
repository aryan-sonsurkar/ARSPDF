# Optional public URL of this project's GitHub repository.
# Used by the header, hero, and footer links.
# If empty, ArsPDF falls back to https://github.com/aryan-sonsurkar/ARSPDF
NEXT_PUBLIC_GITHUB_URL=

# Optional canonical production URL, for example https://arspdf.example.com.
# Used for canonical links, Open Graph metadata, robots.txt, and sitemap.xml.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=
